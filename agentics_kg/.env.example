# Docling-Agentics Knowledge Graph Extractor - Environment Configuration

# =============================================================================
# Upload Directory Configuration
# =============================================================================
# Directory where uploaded and processed files are stored
# Default: /tmp/docling_agentics
DOCLING_AGENTICS_UPLOAD_DIR=/tmp/docling_agentics

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Configure at least one LLM provider below. The application uses LiteLLM
# which supports 100+ providers including OpenAI, Anthropic, Google, Azure, etc.

# -----------------------------------------------------------------------------
# Google Gemini (Recommended - Free tier available)
# -----------------------------------------------------------------------------
# Get your API key at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------
# Get your API key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key-here

# -----------------------------------------------------------------------------
# Anthropic Claude
# -----------------------------------------------------------------------------
# Get your API key at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# -----------------------------------------------------------------------------
# Azure OpenAI
# -----------------------------------------------------------------------------
# AZURE_API_KEY=your-azure-api-key
# AZURE_API_BASE=https://your-resource.openai.azure.com
# AZURE_API_VERSION=2024-02-15-preview

# -----------------------------------------------------------------------------
# AWS Bedrock
# -----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION_NAME=us-east-1

# -----------------------------------------------------------------------------
# Cohere
# -----------------------------------------------------------------------------
# COHERE_API_KEY=your-cohere-api-key

# -----------------------------------------------------------------------------
# Hugging Face
# -----------------------------------------------------------------------------
# HUGGINGFACE_API_KEY=your-huggingface-api-key

# =============================================================================
# Model Configuration (Optional)
# =============================================================================
# Default model to use for extraction
# Examples:
#   - Google: gemini/gemini-1.5-flash, gemini/gemini-1.5-pro
#   - OpenAI: gpt-4, gpt-4-turbo, gpt-3.5-turbo
#   - Anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229
#   - Azure: azure/<deployment-name>
DEFAULT_MODEL=gemini/gemini-1.5-flash

# =============================================================================
# Server Configuration (Optional)
# =============================================================================
# Port for the web server (default: 5000)
# SERVER_PORT=5000

# Host for the web server (default: 0.0.0.0)
# SERVER_HOST=0.0.0.0

# =============================================================================
# Notes
# =============================================================================
# 1. Remove the '#' at the start of a line to enable that configuration
# 2. You only need to configure ONE LLM provider to get started
# 3. Google Gemini offers a generous free tier and is recommended for testing
# 4. For production use, consider rate limits and costs of your chosen provider
# 5. LiteLLM documentation: https://docs.litellm.ai/docs/providers